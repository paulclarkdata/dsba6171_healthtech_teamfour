    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const text = item.json.data || '';\n\n  const getMatch = (regex) => {\n    const match = text.match(regex);\n    return match ? match[1].trim() : null;\n  };\n\n  let documentType = \"Unknown\";\n\n  if (text.includes(\"Medical Policy\")) {\n    documentType = \"Medical Policy\";\n  } else if (text.includes(\"MEMORANDUM\")) {\n    documentType = \"Memorandum\";\n  } else if (text.includes(\"Fee Schedule Matrix\")) {\n    documentType = \"Procedure Guide\";\n  }\n\n  item.json.metadata = {\n    documentId:\n      getMatch(/DOCUMENT ID:\\*\\*\\s*([^\\*\\n]+)/i),\n\n    version:\n      getMatch(/VERSION:\\*\\*\\s*([^\\*\\n]+)/i) ||\n      getMatch(/Version:\\*\\*\\s*([^\\*\\n]+)/i),\n\n    effectiveDate:\n      getMatch(/DATE:\\*\\*\\s*([^\\*\\n]+)/i) ||\n      getMatch(/Effective Date:\\*\\*\\s*([^\\*\\n]+)/i),\n\n    owner:\n      getMatch(/Owner:\\*\\*\\s*([^\\*\\n]+)/i),\n\n    region:\n      getMatch(/Region:\\*\\*\\s*([^\\*\\n]+)/i),\n\n    classification:\n      getMatch(/CONFIDENTIALITY:\\*\\*\\s*([^\\*\\n]+)/i),\n\n    documentType,\n\n    provenance:\n      \"GitHub Repository\"\n  };\n\n  return item;\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        2048
      ],
      "id": "f8352c5e-c928-424a-8f8b-909eb7f53f86",
      "name": "Code in JavaScript"
